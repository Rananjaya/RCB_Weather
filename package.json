{
  "name": "rcb-weather",
  "productName": "RCB Weather",
  "version": "0.5.1",
  "description": "RCB Weather — live weather dashboard (MET Norway, Open-Meteo, OpenWeatherMap).",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "cd www && python3 -m http.server 8080",
    "build:win": "electron-packager . \"RCB Weather\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/ios --ignore=^/dist --ignore=^/node_modules/\\.cache",
    "ios": "cap sync ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@electron/packager": "^18.3.6",
    "electron": "^37.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0"
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Rananjaya"
}
